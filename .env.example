DATABASE_URL="file:./dev.db"

# Pi generation engine (development)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional engine timeout in milliseconds. Defaults to 25 min for a new
# application and 15 min for a conversational modification.
FAYA_ENGINE_TIMEOUT_MS=

# Run the generated acceptance.json flows after each generation/modification.
# Set to 0 to disable (for example when Chromium is not installed on a worker).
FAYA_RUN_ACCEPTANCE=1

# Public URL embedded in exported applications for sync and webhooks.
# Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000.
FAYA_PLATFORM_URL=

# Optional structured log level: debug | info | warn | error
# Defaults to debug in development and info in production.
LOG_LEVEL=

# Deployment profile: local | staging | production
FAYA_PROFILE=local

# Provider adapters. Only the local values are implemented today.
PROJECT_DATA_PROVIDER=sqlite   # sqlite | libsql
RATE_LIMITER=memory            # memory | redis
EVENT_BUS=memory               # memory | redis
JOB_DISPATCHER=process         # process | postgres
STORAGE_PROVIDER=local         # local | s3
