DATABASE_URL="file:./dev.db"

# Pi generation engine (development)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Public URL embedded in exported applications for sync and webhooks.
# Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000.
FAYA_PLATFORM_URL=

# Optional structured log level: debug | info | warn | error
# Defaults to debug in development and info in production.
LOG_LEVEL=
