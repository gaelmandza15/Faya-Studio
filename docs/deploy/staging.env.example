# Staging environment — copy to your hosting provider's secret manager.
# Never commit real values.

DATABASE_URL=postgresql://user:password@host:5432/faya?sslmode=require

FAYA_PROFILE=staging
FAYA_PLATFORM_URL=https://staging.example.com

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

PROJECT_DATA_PROVIDER=sqlite
RATE_LIMITER=memory
EVENT_BUS=memory
JOB_DISPATCHER=process
STORAGE_PROVIDER=local

LOG_LEVEL=info
